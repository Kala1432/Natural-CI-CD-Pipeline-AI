# FluxForge — CI/CD Pipeline Generator environment variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipeline_sh
JWT_SECRET_KEY=your_jwt_secret_here
SECRET_KEY=your_flask_secret_here
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth App (scopes: repo, read:org)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth (for Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Frontend Google Client ID (used by Google Identity Services button)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=your-sender@gmail.com
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# OpenAI (optional — Gemini is the primary AI provider)
OPENAI_API_KEY=

# Gemini AI (primary AI provider — set for AI analysis and log diagnosis)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest

# AWS (for ECR deployment and real EC2 provisioning)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
AWS_S3_BUCKET=fluxforge-artifacts
AWS_EC2_KEY_NAME=fluxforge-ec2-key
AWS_EC2_INSTANCE_TYPE=t3.small
AWS_EC2_AMI_ID=ami-0123456789abcdef0
AWS_EC2_INSTANCE_ID=i-0123456789abcdef0
AWS_SSH_USER=ubuntu
# AWS_DEPLOY_ROLE_ARN is set in GitHub Secrets, not here

# App
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
