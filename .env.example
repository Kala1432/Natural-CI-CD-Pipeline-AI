# HiFi — CI/CD Pipeline Generator environment variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipeline_sh
JWT_SECRET_KEY=your_jwt_secret_here
SECRET_KEY=your_flask_secret_here
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth App (scopes: repo, read:org)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth (for Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=your-sender@gmail.com
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# AWS (Phase 7+)
AWS_REGION=us-east-1
AWS_S3_BUCKET=hifi-pipeline-artifacts
AWS_EC2_KEY_NAME=hifi-ec2-key
AWS_EC2_INSTANCE_TYPE=t3.micro
AWS_AMI_ID=ami-0c94855ba95c71c99
AWS_SSH_USER=ubuntu

# App
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
