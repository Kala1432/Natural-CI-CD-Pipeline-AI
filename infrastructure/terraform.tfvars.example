###############################################################################
# FluxForge — terraform.tfvars (example)
#
# Copy this file to terraform.tfvars and fill in your values. NEVER commit
# terraform.tfvars — it should be in .gitignore.
###############################################################################

aws_region  = "ap-south-1"
project_name = "fluxforge"

# GitHub repo allowed to assume the deploy role.
github_org  = "prabhu"
github_repo = "Natural-CI-CD-Pipeline-AI"

# EC2 instance settings
ec2_instance_type = "t3.small"
# ec2_ami_id     = "ami-0123456789abcdef0"  # Optional — leave empty to auto-pick latest Ubuntu 22.04
# ec2_key_name   = "my-key-pair"            # Optional — leave empty if you don't want SSH access

# Set to false if you already have an EC2 instance you want to use.
create_ec2_instance = true
